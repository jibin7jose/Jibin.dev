---
const { title } = Astro.props;
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Jibin Jose</title>
		<style>
			:root {
				--bg: #ffffff;
				--text: #2d3436;
				--link: #0984e3;
				--border: #dfe6e9;
			}
			body {
				font-family: 'Inter', system-ui, -apple-system, sans-serif;
				max-width: 720px;
				margin: 3rem auto;
				padding: 0 1.5rem;
				line-height: 1.6;
				color: var(--text);
				background-color: var(--bg);
			}
			h1, h2, h3, h4 {
				color: #000;
				margin-top: 2rem;
				line-height: 1.2;
			}
			h1 { font-size: 2.5rem; margin-top: 0; }
			h2 { font-size: 1.5rem; border-bottom: 2px solid var(--border); padding-bottom: 0.5rem; }
			
			nav {
				margin-bottom: 2rem;
			}
			nav a {
				text-decoration: none;
				color: var(--link);
				font-weight: 500;
				transition: opacity 0.2s;
			}
			nav a:hover {
				opacity: 0.7;
				text-decoration: underline;
			}
			
			section {
				margin-bottom: 3rem;
			}
			
			ul {
				padding-left: 1.2rem;
			}
			li {
				margin-bottom: 0.5rem;
			}
			
			hr {
				border: 0;
				border-top: 1px solid var(--border);
				margin: 2rem 0;
			}

			footer {
				margin-top: 4rem;
				font-size: 0.9rem;
				color: #636e72;
				text-align: center;
			}
		</style>
	</head>
	<body>
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
