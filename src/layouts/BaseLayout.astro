---
const { title } = Astro.props;
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import FloatingWidget from '../components/FloatingWidget.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		
		<!-- Phosphor Icons -->
		<script src="https://unpkg.com/@phosphor-icons/web" is:inline></script>
		
		<!-- AOS Animation -->
		<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
		
		<style>
			:root {
				--bg: #ffffff;
				--text: #475569;
				--heading: #0f172a;
				--link: #0284c7;
				--border: #e2e8f0;
				--card-bg: #ffffff;
			}
			* {
				box-sizing: border-box;
			}
			html {
				scroll-behavior: smooth;
				scroll-padding-top: 120px;
			}
			body {
				font-family: 'Inter', system-ui, -apple-system, sans-serif;
				max-width: 800px;
				margin: 0 auto;
				padding: 0 1.5rem; /* Navbar will handle top padding */
				line-height: 1.7;
				color: var(--text);
				background-color: var(--bg);
				-webkit-font-smoothing: antialiased;
				overflow-x: hidden;
			}
			h1, h2, h3, h4 {
				color: var(--heading);
				margin-top: 2.5rem;
				line-height: 1.3;
				font-weight: 600;
			}
			h1 { font-size: 2.75rem; margin-top: 0; letter-spacing: -0.02em; }
			h2 { font-size: 1.75rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; }
			
			nav {
				margin-bottom: 3rem;
				display: flex;
				gap: 1.5rem;
			}
			nav a {
				text-decoration: none;
				color: var(--text);
				font-weight: 500;
				transition: color 0.2s ease, transform 0.2s ease;
			}
			nav a:hover {
				color: var(--link);
				transform: translateY(-1px);
			}
			
			section {
				margin-bottom: 4rem;
				animation: fadeIn 0.8s ease-out forwards;
			}
			
			@keyframes fadeIn {
				from { opacity: 0; transform: translateY(10px); }
				to { opacity: 1; transform: translateY(0); }
			}

			ul {
				padding-left: 1.2rem;
			}
			li {
				margin-bottom: 0.75rem;
			}
			
			hr {
				border: 0;
				border-top: 1px solid var(--border);
				margin: 3rem 0;
			}

			footer {
				margin-top: 5rem;
				font-size: 0.9rem;
				color: #64748b;
				text-align: center;
				padding-bottom: 2rem;
			}
			
			::selection {
				background: var(--link);
				color: #ffffff;
			}
		</style>
	</head>
	<body>
		<Sidebar />
		<Navbar />
		<FloatingWidget />
		<main>
			<slot />
		</main>
		<Footer />
		
		<!-- AOS Init -->
		<script src="https://unpkg.com/aos@2.3.1/dist/aos.js" is:inline></script>
		<script is:inline>
			document.addEventListener("DOMContentLoaded", function() {
				AOS.init({
					duration: 800,
					once: true,
					offset: 50,
				});
			});
		</script>
	</body>
</html>
